PYTHONUNBUFFERED=1
DB_HOST=localhost
DB_PORT=5433
DB_NAME=underwriting
DB_USER=underwriting
DB_PASSWORD=underwriting
DB_AUTH_MODE=password
DB_SSLMODE=prefer
DB_SCHEMA_MANAGED_EXTERNALLY=false
AZURE_CLIENT_ID=
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:5173

# Failure injection
FAIL_RISK_ONCE=false
FAIL_CREDIT_RANDOMLY=false
CRASH_AFTER_EXECUTOR=
CRASH_AFTER_STEP_OR_SUPERSTEP=

# Retry defaults
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_MS=200
RETRY_JITTER_MS=100

# Foundry / LLM (local integration)
AZURE_AI_PROJECT_ID=
AZURE_AI_PROJECT_NAME=
FOUNDRY_MODEL_DEPLOYMENT_NAME=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
DATABASE_URL=
