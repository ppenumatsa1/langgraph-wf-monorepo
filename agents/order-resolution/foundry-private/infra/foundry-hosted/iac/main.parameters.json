{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "infrastructureMode": { "value": "${INFRASTRUCTURE_MODE}" },
    "deployFoundryReadyResources": { "value": "${DEPLOY_FOUNDRY_READY_RESOURCES=false}" },
    "namePrefix": { "value": "${NAME_PREFIX}" },
    "location": { "value": "${AZURE_LOCATION}" },
    "foundryVnetName": { "value": "${FOUNDRY_VNET_NAME}" },
    "foundryAccountName": { "value": "${FOUNDRY_ACCOUNT_NAME}" },
    "foundryProjectName": { "value": "${FOUNDRY_PROJECT_NAME}" },
    "foundryCustomSubDomainName": { "value": "${FOUNDRY_CUSTOM_SUBDOMAIN_NAME}" },
    "hostedAgentName": { "value": "${HOSTED_AGENT_NAME}" },
    "foundryChatDeploymentName": { "value": "${FOUNDRY_MODEL_DEPLOYMENT_NAME}" },
    "foundryChatModelFormat": { "value": "${FOUNDRY_MODEL_FORMAT}" },
    "foundryChatModelName": { "value": "${FOUNDRY_MODEL_NAME}" },
    "foundryChatModelVersion": { "value": "${FOUNDRY_MODEL_VERSION}" },
    "foundryChatModelSkuName": { "value": "${FOUNDRY_MODEL_SKU_NAME}" },
    "foundryChatModelCapacity": { "value": "${FOUNDRY_MODEL_CAPACITY}" },
    "foundryEmbeddingsDeploymentName": { "value": "${FOUNDRY_EMBEDDINGS_DEPLOYMENT_NAME}" },
    "foundryEmbeddingsModelVersion": { "value": "${FOUNDRY_EMBEDDINGS_MODEL_VERSION}" },
    "foundryEmbeddingsModelCapacity": { "value": "${FOUNDRY_EMBEDDINGS_MODEL_CAPACITY}" },
    "foundryEvaluationDeploymentName": { "value": "${FOUNDRY_EVAL_MODEL}" },
    "foundryEvaluationModelCapacity": { "value": "${FOUNDRY_EVALUATION_MODEL_CAPACITY}" },
    "foundryRaiPolicyName": { "value": "${FOUNDRY_RAI_POLICY_NAME}" },
    "containerRegistryName": { "value": "${CONTAINER_REGISTRY_NAME}" },
    "standardAgentStorageAccountName": { "value": "${STANDARD_AGENT_STORAGE_ACCOUNT_NAME}" },
    "standardAgentCosmosAccountName": { "value": "${STANDARD_AGENT_COSMOS_ACCOUNT_NAME}" },
    "standardAgentSearchName": { "value": "${STANDARD_AGENT_SEARCH_NAME}" },
    "standardAgentSearchLocation": { "value": "${STANDARD_AGENT_SEARCH_LOCATION}" },
    "logAnalyticsWorkspaceName": { "value": "${LOG_ANALYTICS_WORKSPACE_NAME}" },
    "applicationInsightsName": { "value": "${APPLICATION_INSIGHTS_NAME}" },
    "azureMonitorPrivateLinkScopeName": { "value": "${AZURE_MONITOR_PRIVATE_LINK_SCOPE_NAME}" },
    "containerAppsEnvironmentName": { "value": "${CONTAINER_APPS_ENVIRONMENT_NAME}" },
    "backendContainerAppName": { "value": "${BACKEND_CONTAINER_APP_NAME}" },
    "frontendContainerAppName": { "value": "${FRONTEND_CONTAINER_APP_NAME}" },
    "privateBackendManagedIdentityName": { "value": "${PRIVATE_BACKEND_MANAGED_IDENTITY_NAME}" },
    "privateFrontendManagedIdentityName": { "value": "${PRIVATE_FRONTEND_MANAGED_IDENTITY_NAME}" },
    "backendImageRepository": { "value": "${BACKEND_IMAGE_REPOSITORY}" },
    "frontendImageRepository": { "value": "${FRONTEND_IMAGE_REPOSITORY}" },
    "postgresServerName": { "value": "${POSTGRES_SERVER_NAME}" },
    "postgresAdministratorLogin": { "value": "${POSTGRES_ADMIN_USERNAME}" },
    "postgresAdministratorPassword": { "value": "${POSTGRES_ADMIN_PASSWORD}" },
    "postgresDatabaseName": { "value": "${POSTGRES_DATABASE}" },
    "privateRunnerVmName": { "value": "${PRIVATE_RUNNER_VM_NAME}" },
    "privateRunnerSshPublicKey": { "value": "${PRIVATE_RUNNER_SSH_PUBLIC_KEY}" },
    "bootstrapRuntimeDatabaseUrl": { "value": "${BOOTSTRAP_RUNTIME_DATABASE_URL}" }
  }
}
