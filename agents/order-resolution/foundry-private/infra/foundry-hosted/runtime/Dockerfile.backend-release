FROM python:3.12.4-slim-bookworm AS runtime

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_INDEX_URL=https://packagefeedproxy.microsoft.io/pypi/simple

COPY backend/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

RUN adduser --disabled-password --gecos "" appuser

COPY --chown=appuser:appuser backend/ ./
COPY --chown=appuser:appuser infra/foundry-hosted/runtime/launch_backend.py /app/.deployment/launch_backend.py
RUN mkdir -p /app/.deployment /app/.foundry/checkpoints /app/.foundry/memory /app/.foundry/results \
    && chown -R appuser:appuser /app/.deployment /app/.foundry

USER appuser

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=3).read()" || exit 1

CMD ["python", "/app/.deployment/launch_backend.py"]
