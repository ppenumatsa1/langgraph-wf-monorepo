APP_ENV=local
DEPLOYMENT_LANE=foundry-private
OTEL_SERVICE_NAME=langgraph-order-resolution-foundry-private-backend
STORE_PROVIDER=postgres
RUNTIME_TARGET=local_langgraph
DB_SCHEMA_MANAGED_EXTERNALLY=true
VERIFY_DB_SCHEMA_ON_STARTUP=true
FRONTEND_ORIGIN=http://localhost:5173
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
LANGGRAPH_STRICT_MSGPACK=true
CHECKPOINT_RETENTION_DAYS=30
POSTGRES_POOL_MIN_SIZE=1
POSTGRES_POOL_MAX_SIZE=10
POSTGRES_POOL_MAX_IDLE_SECONDS=600
POSTGRES_APPLICATION_NAME=langgraph-order-resolution-local
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/langgraph_workflow?sslmode=disable

# Local observability
# ENABLE_TELEMETRY=true
# ENABLE_INSTRUMENTATION=true
# ENABLE_LANGGRAPH_AUTO_TRACING=true
# OTEL_RECORD_CONTENT=false
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...

# Optional local test of the private Foundry Responses wrapper. Run it from a
# network that can resolve the private Foundry endpoint. Do not put this mode or
# endpoint in browser configuration; the internal backend receives its
# managed-identity configuration from deployment automation.
# RUNTIME_TARGET=responses_wrapper
# FOUNDRY_RESPONSES_ENDPOINT=https://<private-foundry-account>.services.ai.azure.com/api/projects/<project>/agents/order-resolution-private-hosted/endpoint/protocols/openai/responses?api-version=v1
# FOUNDRY_RESPONSES_TIMEOUT_SECONDS=60
# FOUNDRY_HOSTED_AGENT_NAME=order-resolution-private-hosted
# FOUNDRY_HOSTED_AGENT_ID=order-resolution-private-hosted
# AZURE_TOKEN_CREDENTIALS=dev

# Report-only Foundry evaluation uses fresh, redacted selected-thread snapshots.
# The private runner can discover the internal frontend through its selected azd
# environment; this HTTPS override is available for other trusted networks.
# FOUNDRY_WORKFLOW_BASE_URL=https://<private-frontend-fqdn>
# HOSTED_E2E_EVIDENCE_FILE=.foundry/results/hosted-e2e-evidence.json
# FOUNDRY_DEPLOYMENT_VERIFICATION_FILE=.foundry/results/deployment-verification.json
# FOUNDRY_EVAL_ENFORCE_PASS=false

# Hosted images receive the resolved database URL only through the Foundry
# project CustomKeys connection. Source and package metadata retain the literal:
# ${{connections.<runtime-connection>.credentials.database_url}}

# MCP integration
# MCP_SERVER_URL=http://localhost:8011/mcp
# MCP_API_KEY=demo-api-key
# MCP_API_KEY_HEADER=X-API-Key
# MCP_BEARER_TOKEN=demo-bearer-token
# MCP_TIMEOUT_SECONDS=15

# Read-only retry guardrails
# READ_RETRY_ATTEMPTS=3
# READ_RETRY_DELAY_SECONDS=0.2

# Optional Azure AI Foundry LangChain model adapter. DefaultAzureCredential is
# used when configured; deterministic triage runs in the same graph otherwise.
# FOUNDRY_PROJECTS_ENDPOINT=https://<foundry-account>.services.ai.azure.com/api/projects/order-resolution
# FOUNDRY_MODEL_DEPLOYMENT_NAME=gpt-4o-mini

# Mock MCP server settings (for scripts/mcp/mock_mcp_server.py)
# MOCK_MCP_API_KEY=demo-api-key
# MOCK_MCP_BEARER_TOKEN=demo-bearer-token
