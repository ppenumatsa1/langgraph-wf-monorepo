{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "targetSubscriptionId": { "value": "${AZURE_SUBSCRIPTION_ID}" },
    "targetResourceGroupName": { "value": "${AZURE_RESOURCE_GROUP}" },
    "location": { "value": "${AZURE_LOCATION}" },
    "infrastructureMode": { "value": "${INFRASTRUCTURE_MODE=bootstrap}" },
    "namePrefix": { "value": "${NAME_PREFIX}" },
    "postgresServerAdministratorLogin": { "value": "${POSTGRES_SERVER_ADMIN_LOGIN=pgbootstrapadmin}" },
    "postgresServerAdministratorPassword": { "value": "${POSTGRES_SERVER_ADMIN_PASSWORD}" },
    "postgresOperatorIp": { "value": "${POSTGRES_OPERATOR_IP=}" }
  }
}
