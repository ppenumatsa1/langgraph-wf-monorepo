# Local environments and generated state in any deployment variant
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example
!**/.env.sample
!**/.env.*.sample
!**/.env.template
!**/.env.*.template
# Keep only non-secret deployment plans; all AZD environment state remains local.
**/.azure/**
!**/.azure/
!**/.azure/deployment-plan.md
**/.azd/
**/terraform.tfstate
**/terraform.tfstate.*
**/*.tfstate
**/*.tfstate.*
**/*.tfplan
**/local.settings.json
**/azd-env.json
**/*.pem
**/*.key
**/*.pfx
**/*.p12
**/*.jks
**/*.keystore
**/.secrets/
**/.venv/
**/__pycache__/
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/
**/.tox/
**/.nox/
**/.coverage
**/.coverage.*
**/htmlcov/
**/*.egg-info/
**/node_modules/
**/dist/
**/build/
**/coverage/
**/.next/
**/.vite/
**/.cache/
**/playwright-report/
**/test-results/
**/.artifacts/

# Local deployment progress reports and operational evidence.
/deployment-reports/
/poc/

# Editor and operating-system files
.vscode/
.idea/
.DS_Store
